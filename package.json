{
  "name": "boneyard-integration-starter",
  "version": "0.1.0",
  "private": true,
  "description": "Starter for building an MCP server that plugs into Boneyard as a connection, plus a conformance kit.",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "start": "node dist/src/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx --test \"test/**/*.test.ts\" \"kit/test/**/*.test.ts\"",
    "kit": "tsx kit/cli.ts",
    "kit:check": "tsx kit/local-check.ts",
    "kit:dev": "tsx kit/cli.ts dev http://127.0.0.1:8750/mcp --token-file .dev/connection-token",
    "verify": "npm run typecheck && npm test && npm run kit:check"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "@modelcontextprotocol/node": "2.1.0",
    "@modelcontextprotocol/server": "2.2.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
